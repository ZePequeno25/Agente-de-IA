```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj
*.so
*.dll
*.exe
*.class
*.out

# Dependencies
.venv/
venv/
env/
node_modules/
dist/
build/
target/
.gradle/
.mypy_cache/
.pytest_cache/
coverage/
htmlcov/
.coverage

# Environment variables
.env
.env.local
.env.*

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo
*.tmp

# System files
.DS_Store
Thumbs.db

# Logs
*.log
logs/
*.jsonl

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst

# Model files (large binaries)
models/
*.gguf
*.bin
*.pt
*.pth
*.onnx
*.safetensors

# Security sensitive files
*.pem
*.key
*.crt
credentials.json
service-account.json
*_secret*
*_private*
```